# Copy to ~/.mcp-manager/.env (created automatically on first launch).
# Relative paths are resolved under MCP_MANAGER_HOME / DATA_DIR.
DATA_DIR=.
DATABASE_URL=
# DATABASE_URL=mysql://user:password@localhost:3306/mcp_manager?charset=utf8mb4
HOST=127.0.0.1
PORT=8765
PUBLIC_URL=http://127.0.0.1:8765
COOKIE_SECURE=false
# SECRET_KEY= ; default persisted in ~/.mcp-manager/secret.key
